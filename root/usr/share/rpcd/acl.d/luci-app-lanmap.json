{
	"luci-app-lanmap": {
		"description": "Grant access to the lanmap ubus object",
		"read": {
			"ubus": {
				"luci.lanmap": [ "devices", "detail", "summary", "status", "log", "selfstatus", "selfcheck" ]
			}
		},
		"write": {
			"ubus": {
				"luci.lanmap": [ "setmeta", "scan", "selfupdate" ]
			}
		}
	}
}
